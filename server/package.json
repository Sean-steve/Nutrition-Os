{
  "name": "nutrition-os-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --exclude 'src/*.integration.test.ts'",
    "test:integration": "vitest run src/http.integration.test.ts",
    "db:migrate": "tsx src/migrate.ts",
    "dev:token": "tsx src/devToken.ts",
    "events:worker": "tsx src/eventsWorker.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^11.0.0",
    "pg": "^8.13.0",
    "jose": "^6.0.0",
    "zod": "^3.24.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
