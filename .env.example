# Frontend uses verified API-backed records in local development.
# Leave blank to use the local Vite proxy at /api -> http://127.0.0.1:3001.
# HTTPS is REQUIRED for nonlocal API origins.
VITE_NUTRITION_API_URL=
# Never put tokens, client secrets, database passwords or personal data in VITE_*.
# On static GitHub Pages, keep false (sample preview until Kernel authentication).
VITE_NUTRITION_LIVE_DEFAULT=false
